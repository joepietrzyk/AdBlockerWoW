{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y lua5.1 luarocks subversion && sudo luarocks install luacheck",
  "postCreateCommand": "bash .devcontainer/fetch-libs.sh",
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=gh-config,target=/home/vscode/.config/gh,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "sumneko.lua",
        "Ketho.wow-api",
        "johnnymorganz.stylua",
        "anthropic.claude-code",
        "eamodio.gitlens"
      ],
      "settings": {
        "Lua.runtime.version": "Lua 5.1",
        "Lua.diagnostics.globals": [
          "C_Timer",
          "CreateFrame",
          "GetTime",
          "UnitName",
          "UnitHealth",
          "DEFAULT_CHAT_FRAME"
        ],
        "Lua.workspace.library": ["${workspaceFolder}/Libs"],
        "Lua.telemetry.enable": false,
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode"
}
